# ─────────────────────────────────────────────────────────────────────────────
# Torob in the Loop — متغیرهای محیطی | Torob in the Loop environment variables
# محلی: این فایل را به ‎.env‎ کپی کنید. لیارا: با ‎liara env set‎ تنظیم کنید (فایل ‎.env‎ آپلود نمی‌شود).
# Local: copy to .env. Liara: set with `liara env set --app torob-in-the-loop KEY=VALUE ...` (.env is never uploaded).
# همهٔ متغیرها اختیاری‌اند و پیش‌فرض دارند. | Every variable is optional and has a default.
# ─────────────────────────────────────────────────────────────────────────────

# ── سرور | Server ──
# محیط اجرا (development فقط برای توسعه) | runtime mode
NODE_ENV=production
# پورت شنود؛ در لیارا باید با port در liara.json یکی باشد | listen port (must match liara.json "port")
PORT=3000
# آدرس شنود | bind address
HOST=0.0.0.0
# سطح لاگ: debug | info | warn | error
LOG_LEVEL=info
# آدرس عمومی برنامه (برای لینک‌ها و QR) | public URL used in links/QR codes
# PUBLIC_BASE_URL=https://torob-in-the-loop.liara.run

# ── مسیرها | Paths ──
# کاتالوگ فقط‌خواندنی (ساخته‌شده با npm run data:build) | read-only catalog DB
# CATALOG_PATH=data/catalog.db
# پایگاه‌دادهٔ وضعیت (استعلام‌ها، گفتگوها)؛ در لیارا روی دیسک ‎/var/lib/torob-in-the-loop‎ | mutable state DB (on the Liara disk)
# پیش‌فرض محلی data/state/state.db؛ در ایمیج Docker ‎/var/lib/torob-in-the-loop/state.db‎
# STATE_DB_PATH=/var/lib/torob-in-the-loop/state.db
# پوشهٔ خروجی وب (SPA) | built SPA directory
# WEB_DIST=apps/web/dist

# ── هوش مصنوعی (Liara AI، سازگار با OpenAI) | LLM via Liara AI (OpenAI-compatible) ──
# بدون این دو مقدار، دستیار در حالت قاعده‌محور (بدون LLM) کار می‌کند. | without both, the assistant runs rule-based.
# LLM_BASE_URL=https://ai.liara.ir/api/v1/<your-ai-id>
# یا BoxAPI | or BoxAPI (the production setup; keys may be limited to certain models):
#   LLM_BASE_URL=https://ai.boxapi.ir/ai/v1
#   LLM_MODEL=openai/gpt-5.4-mini
#   LLM_FAST_MODEL=openai/gpt-5.4-mini
# LLM_API_KEY=
# مدل اصلی گفتگو | main chat model
LLM_MODEL=anthropic/claude-sonnet-5.5
# مدل سریع (جمع‌بندی مقایسه) | fast model (comparison verdicts)
LLM_FAST_MODEL=anthropic/claude-haiku-4.5
# مهلت هر درخواست LLM (میلی‌ثانیه) | per-request timeout (ms)
LLM_TIMEOUT_MS=25000
# حداکثر گام‌های ابزار در هر پیام | max tool-calling steps per message
LLM_MAX_STEPS=6
# خاموش‌کردن اجباری LLM (true/false) | force rule-based mode
LLM_DISABLED=false
# مدل تبدیل گفتار به متن | speech-to-text model
STT_MODEL=openai/whisper-large-v3

# ── تماس و پیگیری | Contact & follow-up ──
# حالت دمو: تماس‌ها شبیه‌سازی می‌شوند (داده‌ها و شماره‌ها ساختگی‌اند) | simulated calls (dataset phones are fake)
DEMO_MODE=true
# ضریب سرعت شبیه‌سازی تماس (۲ = دو برابر سریع‌تر) | simulated call speed multiplier
CALL_SPEED=1
# فاصلهٔ تلاش دوباره (ثانیه) | retry interval (s)
FOLLOWUP_RETRY_SECONDS=45
# حداکثر تلاش برای هر فروشگاه | max attempts per shop
FOLLOWUP_MAX_ATTEMPTS=3

# ── یکپارچه‌سازی‌های اختیاری | Optional integrations ──
# ربات بله | Bale messenger bot
# BALE_BOT_TOKEN=
# BALE_WEBHOOK_SECRET=
# کلید نشان (نقشه/مسیریابی) | Neshan maps API key
# NESHAN_API_KEY=
# کاشی‌های نقشه و اعتبار آن | map tiles + attribution
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# MAP_ATTRIBUTION=&copy; OpenStreetMap

# ── محدودیت نرخ (در دقیقه برای هر IP) | Rate limits (per IP per minute) ──
RATE_LIMIT_CHAT_PER_MIN=20
RATE_LIMIT_INQUIRY_PER_MIN=30

# ── فقط کانتینر | Container only ──
# APP_VERSION=1.0.0          # نسخه در /api/health | version shown in /api/health
# RUN_AS_ROOT=0               # 1 = بدون افت دسترسی | skip privilege drop in entrypoint
# SKIP_CATALOG_CHECK=0        # 1 = بدون بررسی کاتالوگ در شروع | skip catalog check
