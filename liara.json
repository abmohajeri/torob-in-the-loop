{
  "app": "torob-in-the-loop",
  "platform": "docker",
  "port": 3000,
  "build": {
    "dockerfile": "Dockerfile.runtime",
    "cache": true
  },
  "disks": [
    {
      "name": "torob-in-the-loop-data",
      "mountTo": "/var/lib/torob-in-the-loop"
    }
  ],
  "healthCheck": {
    "command": [
      "CMD",
      "node",
      "/app/scripts/healthcheck.mjs"
    ],
    "interval": 30000,
    "timeout": 10000,
    "retries": 3,
    "startPeriod": 3000
  }
}
